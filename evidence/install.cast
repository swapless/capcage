[0.006, "o", "==== Cap: install into the Halden cage + air-gap proof (docs/RECORDING.md) ====\r\n(the cage/cluster is the customer's pre-existing environment)\r\n\r\n## 2. Install from zero\r\n\r\n\u001b[1;36m$ kubectl create namespace cap --dry-run=client -o yaml | kubectl apply -f -\u001b[0m\r\n"]
[0.938, "o", "namespace/cap unchanged\r\n"]
[0.210, "o", "\r\n\u001b[1;36m$ helm upgrade --install cap install/helm/cap -n cap -f install/helm/cap/profiles/values-kind.yaml --atomic --wait --timeout 10m\u001b[0m\r\n"]
[84.795, "o", "\r\nEgress proxy: disabled\r\nProxy CA injection: disabled\r\n"]
[0.001, "o", "\r\n\u001b[1;36m$ kubectl -n cap get pods\u001b[0m\r\n"]
[0.434, "o", "NAME                       READY   STATUS    RESTARTS   AGE\r\ncap-minio-0                1/1     Running   0          84s\r\ncap-mysql-0                2/2     Running   0          84s\r\ncap-web-74d65d7846-xrjrh   1/1     Running   0          84s\r\n"]
[0.200, "o", "\r\n\u001b[1;36m$ kubectl -n cap logs deploy/cap-web | grep -i migrat\u001b[0m\r\n"]
[0.395, "o", "Defaulted container \"web\" out of: web, wait-for-mysql (init)\r\n"]
[0.006, "o", "Waiting 5 seconds to run migrations\r\n🔍 DB migrations triggered\r\n💿 Running DB migrations...\r\n💿 Migrations run successfully!\r\n"]
[0.195, "o", "\r\n## 3. The cage bites (least privilege + admission)\r\n"]
[0.000, "o", "\r\n\u001b[1;36m$ kubectl auth can-i get nodes --as=system:serviceaccount:cap:cap-deployer\u001b[0m\r\n"]
[0.366, "o", "Warning: resource 'nodes' is not namespace scoped\r\n\r\n"]
[0.002, "o", "no\r\n"]
[0.189, "o", "\r\n\u001b[1;36m$ kubectl -n cap get pod -l app.kubernetes.io/component=web -o jsonpath='{.items[0].spec.serviceAccountName} {.items[0].spec.automountServiceAccountToken}'\u001b[0m\r\n"]
[0.376, "o", "cap false"]
[0.196, "o", "\r\n"]
[0.001, "o", "\r\n\u001b[1;36m$ kubectl -n cap run bad --dry-run=server --image=evil.example.com/x:latest --overrides={restricted securityContext}\u001b[0m\r\n"]
[0.587, "o", "The pods \"bad\" is invalid: : ValidatingAdmissionPolicy 'cap-image-provenance' with binding 'cap-image-provenance' denied request: image not from an allowed registry; allowed: registry.halden.internal/, docker.io/, ghcr.io/\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "## 4. Air-gap assertion (manual)\r\n"]
[0.001, "o", "\r\n\u001b[1;36m$ kubectl -n halden-platform get configmap egress-allowlist -o 'jsonpath={.data.allowlist\\.txt}' | wc -c   # 0 = full deny\u001b[0m\r\n"]
[0.603, "o", "0\r\n"]
[0.001, "o", "\r\n\u001b[1;36m$ kubectl -n cap exec deploy/cap-web -c web -- sh -c 'wget -S -qO /dev/null http://127.0.0.1:3000/ | grep HTTP'   # app serves\u001b[0m\r\n"]
[0.457, "o", "  HTTP/1.1 307 Temporary Redirect\r\n"]
[0.027, "o", "  HTTP/1.1 200 OK\r\n"]
[0.199, "o", "\r\n\u001b[1;36m$ kubectl -n cap exec deploy/cap-web -c web -- sh -c 'http_proxy=... wget http://api.stripe.com/'   # denied 403\u001b[0m\r\n"]
[0.512, "o", "wget: server returned error: HTTP/1.1 403 Forbidden\r\n"]
