[0.001, "o", "\r\n## 5. Verify images without trusting the vendor\r\n"]
[0.000, "o", "\r\n\u001b[1;36m$ DIG=$(docker inspect --format \"{{index .RepoDigests 0}}\" localhost:5050/cap/capsoftware/cap-web:mirrored-8ee4cbd | cut -d@ -f2)\u001b[0m\r\n"]
[0.025, "o", "\r\n\u001b[1;36m$ cosign verify --key supply-chain/cosign.pub --insecure-ignore-tlog=true localhost:5050/cap/capsoftware/cap-web@$DIG\u001b[0m\r\n"]
[1.657, "o", "  - The cosign claims were validated\r\n  - The signatures were verified against the specified public key\r\n"]
[0.003, "o", "(negative test — verify with a different key fails — is in evidence/image-verification.txt)\r\n\r\n==== done ====\r\n"]
